<Project Sdk="Microsoft.NET.Sdk">
  <!-- ★ #46 r1 M2 (session 2): the C# harness. The MSTest project targets net10.0-windows + the MAUI app and never runs on
       this branch's CI, so the pure C# rules were "executed" nowhere a gate could see. This console project compiles
       the REAL files below (no copies) against Stubs.cs and runs the MSTest classes through a tiny attribute runner
       (Run.cs). Run: node scripts/run-csh.mjs  (needs the .NET 8+ SDK; no NuGet access — nuget.config clears the sources). -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>disable</ImplicitUsings><Nullable>enable</Nullable><NoWarn>CS8618;CS8600;CS8602;CS8604;CS0168;CS0649;CS8625</NoWarn>
    <!-- ★ P-1 (#1127) — TEMPORARY: P1Perf.cs is compiled with its dev bodies (the [P1] grammar is executed here). -->
    <DefineConstants>$(DefineConstants);SPIXI_DEV_COEXIST</DefineConstants></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Spixi/Utils/PresenceDisplay.cs" />
    <Compile Include="../../Spixi/Meta/SSightingStore.cs" />
    <Compile Include="../../Spixi/Utils/ImageSniff.cs" />
    <Compile Include="../../Spixi/Utils/P1Perf.cs" />
    <!-- ★ #1132 (session 4): the pure rules behind P-1 levers 2 / 3 / 5 / 11 (tests: OpenPerfRulesTests.cs, beside this file). -->
    <Compile Include="../../Spixi/Utils/OpenPerfRules.cs" />
    <!-- ★ #1148 (3)/(4): the unread rule + the reaction-heart store (tests: UnreadRuleTests.cs, beside this file). -->
    <Compile Include="../../Spixi/Utils/UnreadRule.cs" />
    <Compile Include="../../Spixi/Meta/SReactionFlags.cs" />
    <!-- ★★ P0 #1155 (session 5): the arrival guard (tests: ArrivalGuardTests.cs — a model of Core's cache + delayed writer). -->
    <Compile Include="../../Spixi/Utils/ArrivalGuard.cs" />
    <Compile Include="../../Spixi-UnitTests/PresenceDisplayTests.cs" />
    <Compile Include="../../Spixi-UnitTests/SightingStoreTests.cs" />
    <Compile Include="../../Spixi-UnitTests/ImageSniffTests.cs" />
  </ItemGroup>
</Project>
