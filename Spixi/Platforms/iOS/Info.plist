<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<!-- ★★ E1c (2026-09-07): appicon -> appicon_ios. The resizetizer names the generated
	     .appiconset after the MauiIcon FILE, so giving iOS its own appicon_ios.svg renamed
	     the icon set, and actool failed the build with "None of the input catalogs contained
	     a matching ... app icon set ... named appicon". This string and the iOS MauiIcon
	     Include in Spixi.csproj are ONE coupling with nothing but this comment holding it
	     together, so smoke-test pins them equal.
	     MacCatalyst keeps "appicon" in ITS Info.plist and is correct to: it rides the Android
	     MauiIcon line, whose file really is appicon.svg. -->
	<string>Assets.xcassets/appicon_ios.appiconset</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Spixi uses the camera to scan QR codes and to take photos for chats.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Location access is needed for push notifications when app is in background</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Location access is needed for push notifications when app is in use</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Spixi uses the microphone for voice calls and to record voice messages.</string>
	<!-- ★ V1A-M Drop 1 (compile-risk report R-1): the photo viewer's Save opens the share sheet on iOS / Mac
	     (SingleChatPage savePhoto -> SFileOperations.share). Its "Save Image" / "Add to Photos" writes to the
	     photo library; without this key iOS terminates the app. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Spixi saves the photos you choose to your photo library.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Biometric authentication for unlocking the app</string>
	<key>CFBundleVersion</key>
	<string>0.9.22.11</string>
	<key>CFBundleShortVersionString</key>
	<string>0.9.22</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
	</array>
	<!-- #919: OneSignal's SDK reads THIS key to find its shared UserDefaults suite; without it the
	     extension cannot report confirmed delivery (office findings §11). Pinned equal to the App
	     Group in both entitlements. -->
	<key>OneSignal_app_groups_key</key>
	<string>group.com.ixilabs.spixi</string>
</dict>
</plist>
