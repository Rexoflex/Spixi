<Project Sdk="Microsoft.NET.Sdk" Condition="$(TargetFramework.Contains('-ios'))">
	<PropertyGroup>
		<TargetFrameworks>net10.0-ios</TargetFrameworks>
		<OutputType>Library</OutputType>

		<!-- #919: NO fixed RuntimeIdentifier — the app's simulator RID is a PROJECT property and
		     does not reach a referenced extension, so a hard `ios-arm64` here broke every Debug
		     simulator build the moment the ProjectReference went live (#46 reviewer MAJOR-2). The
		     device build passes its RID globally. -->

		<ApplicationId>com.ixilabs.spixi.Spixi-PushService</ApplicationId>

		<!-- #919: the SAME versions as the app (Spixi.csproj) — a mismatch is W0071/W0073 at build
		     and a rejection at App Store Connect; the pin holds them equal. -->
		<ApplicationDisplayVersion>0.9.22</ApplicationDisplayVersion>
		<ApplicationVersion>160009220</ApplicationVersion>

		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<ImplicitUsings>enable</ImplicitUsings>
		<SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup>
		<IsAppExtension>True</IsAppExtension>
		<IsWatchExtension>False</IsWatchExtension>
	</PropertyGroup>

	<!-- #919: DEVICE builds only (the OneSignal SDK's own demo extension does the same, "no profile
	     is issued for simulator"); a simulator RID skips manual signing entirely. -->
	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios' AND '$(RuntimeIdentifier)' != '' AND !$(RuntimeIdentifier.StartsWith('iossimulator'))">
		<CodesignKey>iPhone Developer</CodesignKey>
		<ProvisioningType>manual</ProvisioningType>
		<!-- #919: the regenerated development profile for com.ixilabs.spixi.Spixi-PushService
		     (the one that expired 2026-08-11; it must carry the App Group). Empty = the toolchain
		     auto-selects the best-matching installed profile; put the name here to PIN it after the
		     portal steps (DECISIONS #915). -->
		<CodesignProvision></CodesignProvision>
	</PropertyGroup>

	<PropertyGroup Condition="!$(TargetFramework.Contains('-ios'))">
		<BuildProject>false</BuildProject>
	</PropertyGroup>

	<PropertyGroup>
		<MtouchNoSymbolStrip Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">True</MtouchNoSymbolStrip>
	</PropertyGroup>

	<ItemGroup>
		<!-- #919 (Session AC): the SAME version the app pins (Spixi.csproj) — two SDK versions in one
		     bundle is a build conflict; the pin holds them equal. -->
		<PackageReference Include="OneSignalSDK.DotNet" Version="6.1.9" />
	</ItemGroup>
</Project>