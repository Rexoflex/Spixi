<?xml version="1.0" encoding="utf-8" ?>
<d:SpixiContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="clr-namespace:SPIXI;assembly=SPIXI"
             x:Class="SPIXI.ScanPage"
             Title="ScanPage">
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <!-- ★ S16 #46 r1 (#1313 MAJOR #9, R1-M1): ClassId="scan" = the ONE WebView Android may give the camera
                 (WebViewRenderer.OnPermissionRequest → S16SecRules.captureRefusal). Set here in XAML: no document can
                 change it. -->
            <WebView x:Name="webView" ClassId="scan" Navigating="onNavigating" Navigated="onNavigated" VerticalOptions="Fill" HorizontalOptions="Fill"/>
        </Grid>
    </ContentPage.Content>
</d:SpixiContentPage>