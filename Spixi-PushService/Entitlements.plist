<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<!-- #919/#915 (Session AC): the App Group shared with the app, so SpixiPushGate can read
		     the store SPushPrefsShare writes. Pinned equal to the app's Entitlements.plist and
		     both C# constants. The extension's development profile must carry it (regenerate). -->
		<key>com.apple.security.application-groups</key>
		<array>
			<string>group.com.ixilabs.spixi</string>
		</array>
	</dict>
</plist>
