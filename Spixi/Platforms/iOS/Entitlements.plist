<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  APNS-1 (2026-08-21). The app had NO entitlements file at all, so it never asked iOS
	  for an APNs device token and OneSignal had no subscription to address. Push has
	  therefore never worked on any iOS device build of the redesign.

	  `development` pairs with an iOS App Development profile. A distribution/TestFlight
	  build needs `production` here — see the IsPublish PropertyGroup in Spixi.csproj.

	  #919/#915 (Session AC): com.apple.security.application-groups IS ADDED NOW — the
	  Notification Service Extension (Spixi-PushService, referenced from Spixi.csproj since
	  this batch) reads the mute set and the display names from the App Group container
	  (SPushPrefsShare.cs writes it). ⚠ codesign FAILS until the development profile for
	  com.ixilabs.spixi carries the group: create `group.com.ixilabs.spixi` in the portal,
	  enable App Groups on BOTH App IDs, regenerate BOTH profiles (DECISIONS #915). The
	  string is pinned equal to the extension's Entitlements.plist and both C# constants.
	-->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.ixilabs.spixi</string>
	</array>
</dict>
</plist>
