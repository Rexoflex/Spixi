<Project Sdk="Microsoft.NET.Sdk">
  <!-- ★ #46 r1 M2 (session 2): the C# harness. The MSTest project targets net10.0-windows + the MAUI app and never runs on
       this branch's CI, so the pure C# rules were "executed" nowhere a gate could see. This console project compiles
       the REAL files below (no copies) against Stubs.cs and runs the MSTest classes through a tiny attribute runner
       (Run.cs). Run: node scripts/run-csh.mjs  (needs the .NET 8+ SDK; no NuGet access — nuget.config clears the sources).
       ★ session 6: the target framework = the RUNNING SDK's own runtime (BundledNETCoreAppTargetFrameworkVersion), so the
       newest installed SDK builds it with no reference-pack download (a fixed net8.0 failed with only the .NET 10 SDK:
       NU1100 Microsoft.NETCore.App.Ref 8.0). run-csh.mjs picks the newest SDK. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net$(BundledNETCoreAppTargetFrameworkVersion)</TargetFramework><ImplicitUsings>disable</ImplicitUsings><Nullable>enable</Nullable><NoWarn>CS8618;CS8600;CS8602;CS8604;CS0168;CS0649;CS8625</NoWarn>
