<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- ★ I-1 (handover sweep): THE LOCAL FEED IS SCOPED TO ONE PACKAGE ID.

       A folder source with no <packageSourceMapping> is unscoped: any .nupkg dropped into
       local-nuget/ shadows a public package of the same id, at any version, for every
       restore. The payload here is a NATIVE library that links into a wallet app, and one
       pull request is the whole attack. docs/opus-review-273-281.md recommended this fix and
       it was never applied.

       <clear /> removes the sources this file inherits, so the two sources below are the
       only ones a restore uses. Every package except RocksDB must come from nuget.org.
       RocksDB is mapped to BOTH sources on purpose: Spixi.csproj asks the local feed for
       version 0.0.42 on android and ios, and nuget.org for version 10.4.2.64152 on every
       other target. Do not delete the nuget.org RocksDB pattern. The longest matching
       pattern wins, so that one line is what keeps the public versions resolvable.

       ⚠ This file cannot be validated in the container that wrote it. There is no .NET
       toolchain there. The first restore is the test. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Repo-local feed for the dev's custom RocksDB-Sharp (RocksDB 0.0.42, not on nuget.org).
         Drop RocksDB.0.0.42.nupkg into local-nuget/ and restore resolves it on any machine.
         Integrity of the committed file, computed from the tracked bytes:
           SHA-512 96e2839f641e7b4c071693fb772b92c46c27867208104ae187c794df95a1e957
                   04dddf98f510f8fa11f38bb88503ae5124fe0bee88f655282a9458647eb7f853
           SHA-256 5fedf9d7d8cf81f56c85e90b3e8451eb0c01050638b7b5f23027f1f322a56851
           size    1008408 bytes
         Reproduce with: sha512sum local-nuget/RocksDB.0.0.42.nupkg -->
    <add key="local" value="local-nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="RocksDB" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="RocksDB" />
    </packageSource>
  </packageSourceMapping>
</configuration>
