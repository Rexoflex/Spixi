<?xml version="1.0" encoding="utf-8" ?>
<d:SpixiContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="clr-namespace:SPIXI;assembly=SPIXI"
             x:Class="SPIXI.MiniAppPage">
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <!-- ClassId="miniapp" = the UNTRUSTED-content marker (#334, security MAJOR #4
                 Android leg): platform renderers/handlers key privilege drops on it
                 (Android: DomStorageEnabled stays OFF for this WebView). -->
            <WebView x:Name="webView" ClassId="miniapp" Navigating="onNavigating" Navigated="onNavigated" VerticalOptions="Fill" HorizontalOptions="Fill"/>
        </Grid>
    </ContentPage.Content>
</d:SpixiContentPage>