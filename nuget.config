<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Repo-local feed for the dev's custom RocksDB-Sharp (RocksDB 0.0.42, not on nuget.org).
         Drop RocksDB.0.0.42.nupkg into local-nuget/ and restore resolves it on any machine. -->
    <add key="local" value="local-nuget" />
  </packageSources>
</configuration>
