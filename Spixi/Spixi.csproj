<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<DefineConstants>$(DefineConstants);__MOBILE__</DefineConstants>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<!-- Windows target only when building ON Windows (NETSDK1100 guard for Mac bring-up, 2026-07-20) -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net10.0-tizen</TargetFrameworks> -->
		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->
		<OutputType>Exe</OutputType>
		<RootNamespace>Spixi</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Display name -->
		<ApplicationTitle>Spixi</ApplicationTitle>
		<!-- App Identifier -->
		<ApplicationId>com.ixilabs.spixi</ApplicationId>
		<!-- ★ #732 DEV-COEXIST (Damir 2026-08-31): ANDROID test builds install BESIDE the
		     Play-signed legacy Spixi on one phone (same ID + different signing key is
		     refused by Android, and uninstalling legacy deletes its wallet). Debug defaults
		     ON; a real-behaviour Release test build opts in with -p:SpixiDevCoexist=true.
		     RELEASE-SAFE BY CONSTRUCTION: a store Release build never passes the property,
		     so it ships com.ixilabs.spixi untouched — but LOGGED FOR REMOVAL at release
		     hardening anyway (DECISIONS #732; grep SpixiDevCoexist, delete the five lines).
		     Android-only: the Windows MSIX identity and iOS bundle id never move.
		     ★ Session I: the SPIXI_DEV_COEXIST compile symbol rides the same property — it gates
		     the seed harness (Utils/SDevSeed.cs + SettingsPage's setDevSeed push + the two
		     ixian:devseed/devunseed verbs) on EVERY platform of a dev build, and is absent
		     from a store build by the same construction.
		     ⚠ Known dev-install caveats: separate app = separate wallet (fresh account),
		     and FCM/OneSignal push may not arrive on the .dev package (FCM config is bound
		     to the package name) — UI walks unaffected. -->
		<SpixiDevCoexist Condition="'$(SpixiDevCoexist)' == '' and '$(Configuration)' == 'Debug'">true</SpixiDevCoexist>
		<ApplicationId Condition="'$(SpixiDevCoexist)' == 'true' and $(TargetFramework.Contains('-android'))">com.ixilabs.spixi.dev</ApplicationId>
		<ApplicationTitle Condition="'$(SpixiDevCoexist)' == 'true' and $(TargetFramework.Contains('-android'))">Spixi Dev</ApplicationTitle>
		<DefineConstants Condition="'$(SpixiDevCoexist)' == 'true'">$(DefineConstants);SPIXI_DEV_COEXIST</DefineConstants>
		<!-- Versions -->
		<ApplicationDisplayVersion>0.9.22</ApplicationDisplayVersion>
		<ApplicationVersion>160009220</ApplicationVersion>
		<!-- NU1105 (Session N, first restore from an empty obj on this SDK): NuGet requires ONE
		     PackageVersion across all TFMs. MAUI derives it from ApplicationDisplayVersion on the
		     mobile TFMs while the Windows TFM fell back to 1.0.0 — pin it to the display version. -->
		<PackageVersion>$(ApplicationDisplayVersion)</PackageVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
		<DefaultLanguage>en</DefaultLanguage>
		<GenerateAppInstallerFile>False</GenerateAppInstallerFile>
		<AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
		<GenerateTestArtifacts>True</GenerateTestArtifacts>
		<HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
		<Platforms>AnyCPU;x64;arm64</Platforms>
	</PropertyGroup>
	<PropertyGroup>
		<MtouchLink>SdkOnly</MtouchLink>
	</PropertyGroup>
	<!-- iOS bring-up (2026-07-22): default Debug iOS builds (no explicit RID) to the Simulator on
	     Apple Silicon, so the RID-conditioned NativeReferences below pick the matching RocksDB
	     slice at evaluation time. An explicit -p:RuntimeIdentifier=ios-arm64 (device) overrides this. -->
	<!-- #273-#281 review D1: opt-in on Debug exactly — '!= Release' would force the SIMULATOR
	     slice onto custom device configurations (Ad-Hoc / AppStore / Enterprise). -->
	<!-- W0 (#336, Windows findings 2026-08-12): OS-guarded — without IsOSPlatform('osx')
	     this default collided with the SLN's Debug→x64 PlatformTarget on Windows
	     (NETSDK RID/PlatformTarget incompatibility) and broke Build Solution outright. -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-ios')) and '$(RuntimeIdentifier)' == '' and '$(Configuration)' == 'Debug' and $([MSBuild]::IsOSPlatform('osx'))">
		<RuntimeIdentifier>iossimulator-arm64</RuntimeIdentifier>
	</PropertyGroup>
	<ItemGroup Condition="$(TargetFramework.Contains('-ios')) and $(RuntimeIdentifier.Contains('iossimulator'))">
		<NativeReference Include="Platforms/iOS/NativeLibraries/RocksDB.xcframework/ios-arm64_x86_64-simulator/librocksdb_full.a">
			<Kind>Static</Kind>
			<ForceLoad>true</ForceLoad>
			<IsCxx>true</IsCxx>
		</NativeReference>
	</ItemGroup>
	<ItemGroup Condition="$(TargetFramework.Contains('-ios')) and !$(RuntimeIdentifier.Contains('iossimulator'))">
		<NativeReference Include="Platforms/iOS/NativeLibraries/RocksDB.xcframework/ios-arm64/librocksdb_full.a">
			<Kind>Static</Kind>
			<ForceLoad>true</ForceLoad>
			<IsCxx>true</IsCxx>
		</NativeReference>
	</ItemGroup>
	<ItemGroup Condition="$(TargetFramework.Contains('-android'))">
		<AndroidNativeLibrary Include="Platforms/Android/lib/arm64-v8a/librocksdb.so">
			<Abi>arm64-v8a</Abi>
		</AndroidNativeLibrary>

		<AndroidNativeLibrary Include="Platforms/Android/lib/armeabi-v7a/librocksdb.so">
			<Abi>armeabi-v7a</Abi>
		</AndroidNativeLibrary>

		<AndroidNativeLibrary Include="Platforms/Android/lib/x86_64/librocksdb.so">
			<Abi>x86_64</Abi>
		</AndroidNativeLibrary>
	</ItemGroup>

	<!-- #920 (Session AC, route B): the vendored RocksDbSharp source (Platforms/MacCatalyst/RocksDbSharp/)
	     has 275 `unsafe` sites; this TFM alone may compile them. The other TFMs never see the folder
	     (the Compile Remove below) and keep the app's default. -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-maccatalyst'))">
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<!-- #273-#281 review D2: the dylib is a machine-local shim (gitignored) — gate on Exists so a
	     clean clone still builds the other TFMs; catalyst then fails at RocksDB init (documented in
	     mac-bringup-log.md) instead of dying at link time on a missing file. -->
	<ItemGroup Condition="$(TargetFramework.Contains('-maccatalyst')) and Exists('Platforms/MacCatalyst/NativeLibraries/librocksdb.dylib')">
		<!-- Mac bring-up (2026-07-20): vtool-restamped copy of the NuGet osx-arm64 rocksdb dylib (macOS-&gt;maccatalyst platform tag); local shim, NOT committed - proper fix is a maccatalyst slice in the dev's RocksDB.xcframework -->
		<NativeReference Include="Platforms/MacCatalyst/NativeLibraries/librocksdb.dylib">
			<Kind>Dynamic</Kind>
			<SmartLink>false</SmartLink>
		</NativeReference>
	</ItemGroup>
	<PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
		<ProvisioningType>manual</ProvisioningType>
		<CodesignKey>iPhone Developer</CodesignKey>
		<!-- APNS-1 (2026-08-21): the app had NO entitlements file, so it never registered
		     for an APNs token and OneSignal had no subscription to address. Push has never
		     worked on any iOS DEVICE build of the redesign.
		     WARNING: codesign now VALIDATES this against the profile. A profile without
		     aps-environment (e.g. the wildcard "iOS Team Provisioning Profile: *") will
		     FAIL the build by design - that failure is the gate working, not a defect.
		     Use an App Development profile made for com.ixilabs.spixi with Push ticked. -->
		<CodesignEntitlements>Platforms/iOS/Entitlements.plist</CodesignEntitlements>
		<!-- ★ S15 (O-31, #1293): aps-environment follows the build configuration. Debug keeps
		     Entitlements.plist (aps-environment development - the App Development profile);
		     a STORE Release takes Entitlements.Release.plist (production - what a TestFlight / App Store
		     build must carry, release-readiness G-9a). The two files differ ONLY in that value
		     (pinned: scripts/pins-s15/d-build.mjs). Configuration is set before this body is read
		     (SDK props), so the condition sees the real value.
		     ★ Only a STORE build (Release + -p:SpixiStoreRelease=true, the O-35 gate) takes production: a plain
		     Release DEVICE build signed with the Development profile (the #807 walk shape) keeps development,
		     so walk builds still sign. -->
		<CodesignEntitlements Condition="'$(Configuration)' == 'Release' And '$(SpixiStoreRelease)' == 'true'">Platforms/iOS/Entitlements.Release.plist</CodesignEntitlements>
	</PropertyGroup>
	<PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
		<UseInterpreter>true</UseInterpreter>
	</PropertyGroup>
	<PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		<RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>
		<AndroidUseLatestPlatformSdk>true</AndroidUseLatestPlatformSdk>
		<!-- ★ S14 (#1280): this property is IGNORED - the merged manifest says targetSdkVersion 36 (it comes from the
		     platform, AndroidUseLatestPlatformSdk). So Android 16 runs predictive back for us; MainActivity's back callback
		     is built for that. Left unchanged on purpose; do not read 35 as the real target. -->
		<TargetSdkVersion>35</TargetSdkVersion>
	</PropertyGroup>
	<PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
		<!-- ★★ #684-adjacent / row 5 (Session F) — THE MULTI-SIZE .ico.
		     Damir reported the Windows icon as "rough" at small sizes. Cause, measured at the
		     artifact: the resizetizer's generated appicon_windows.ico carries exactly ONE
		     64x64 bitmap, so Windows invents 16/24/32/40 by downscaling it.
		     ⚠ THERE IS NO SIZE LIST IN THIS REPO TO CHANGE. Nothing here produces that .ico —
		     no ApplicationIcon property existed, no .ico file was committed, there are no
		     Directory.Build.props, and the one custom target in this project is unrelated.
		     MauiIcon exposes no size-list metadata. The .ico is emitted entirely inside the
		     MAUI SDK's Resizetizer. So the fix is to STOP taking the generated one for the
		     executable and ship a committed icon that has all seven sizes.
		     ★ appicon_windows.ico is rendered FROM appicon_windows.svg — same artwork, no new
		     source of truth — at 16/24/32/48/64/128/256, each rasterised from VECTOR at its own
		     size rather than downscaled, 32bpp BGRA with alpha, PNG-compressed at 256.
		     ⚠ VERIFIED AT THE ARTIFACT, NEVER AT THE TASKBAR (which caches a stale square
		     indefinitely): the container's ICONDIR was read back independently and by
		     ImageMagick — 7 entries, the exact expected sizes, and alpha 0 on all four corner
		     pixels of every entry. smoke-test pins that; see the row-5 pin.
		     ⚠⚠ THIS IS A COMMITTED ASSET SITTING BESIDE A GENERATED ONE — the L17 shape, which
		     has already cost two clean rebuilds. It is deliberate and it is pinned, but the
		     FIRST Windows build must confirm the .exe takes THIS file and not the resizetizer's.
		     ★ If the icon ever needs to change, re-render it from the SVG; do not hand-edit. -->
		<ApplicationIcon>Platforms\Windows\appicon_windows.ico</ApplicationIcon>
		<SatelliteResourceLanguages>en-US;en</SatelliteResourceLanguages>
		<AppxPackage>false</AppxPackage>
		<PublishAppxPackage>false</PublishAppxPackage>
		<WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-windows10.0.19041.0|x64'">
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	</PropertyGroup>
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios' and '$(IsPublish)' == 'true'">
		<CodesignKey>iPhone Distribution</CodesignKey>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|x64'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|arm64'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>
	<!-- strip exited with code 139 workaround - https://github.com/xamarin/xamarin-macios/issues/19157 -->
	<PropertyGroup>
		<MtouchNoSymbolStrip Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">True</MtouchNoSymbolStrip>
		<WindowsPackageType>None</WindowsPackageType>
	</PropertyGroup>
	<ItemGroup>
		<!-- App Icon -->
		<!-- ★ L17: an ADAPTIVE icon, declared as one. The resizetizer emits
		     mipmap-anydpi-v26/appicon.xml with background + foreground + MONOCHROME layers
		     whether we ask for it or not; a single-file icon put the whole opaque square
		     into the foreground, which Android then zoomed 1.5x (undoing the padding) and
		     tinted as a solid blob for themed icons. Splitting them is what makes the
		     "smaller mark" real on the screen rather than only in the file. -->
		<!-- ★★ E1b (Damir 2026-08-29): WINDOWS GETS ITS OWN ICON, and the split is forced by a
		     MEASURED conflict rather than by taste. The shared pair pads the mark to 31.8% of the
		     1024 tile because L17 needs that headroom for Android's adaptive mask + ~1.5x foreground
		     zoom. Windows neither masks nor zooms — it draws the composed square as-is — so the
		     same padding renders the taskbar mark at about two thirds the size Android shows, with
		     square corners nothing rounds for it. Shrinking the padding would fix Windows and break
		     Android, so the two platforms take different files.
		     ⚠ THE ANDROID/iOS PAIR BELOW IS UNCHANGED. Keep it that way — its foreground/background
		     split is what makes the "smaller mark" real on a launcher (L17), and a single-file icon
		     there put the whole opaque square into the foreground.
		     ⚠⚠ CORRECTED BY THE SESSION F AUDIT — THIS PARAGRAPH USED TO SAY "Color is IDENTICAL
		     on both lines on purpose". IT IS NOT, AND MUST NOT BE. E1b DROPPED Color from the
		     Windows line four lines below (it floods the rounded corners — the reason is spelled
		     out there), and this text was left behind asserting an invariant the file no longer
		     holds. A reader working top-down would "restore" it and hand back the square corners
		     Damir reported. Color lives on the ANDROID/iOS line ONLY.
		     ★ What is still true: Color is the flat ground a platform takes when it will not
		     rasterise the file, and #689 settled THAT value by measurement (the icon was
		     under-saturated, not too dark). It matters on Android/iOS, which have no ground of
		     their own; the Windows file carries its own. -->
		<MauiIcon Condition="!$(TargetFramework.Contains('-windows')) and !$(TargetFramework.Contains('-ios')) and !$(TargetFramework.Contains('-maccatalyst'))" Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0076E1" />
		<!-- ★ B14 (office walk #1084, M3: the Dock logo small): Mac Catalyst took the Android adaptive pair
		     above (mark = 31.8% of the tile). It takes its OWN file on Apple's macOS icon grid - see
		     appicon_mac.svg for the whole argument. NO Color, for the E1b reason (the file carries its ground
		     and its transparent margin; a Color would flood that margin). -->
		<MauiIcon Condition="$(TargetFramework.Contains('-maccatalyst'))" Include="Resources\AppIcon\appicon_mac.svg" />
		<!-- ★ E1c (2026-09-07): iOS takes its OWN file, for the reason E1b split Windows off —
		     it neither masks-with-headroom nor zooms the foreground, so the Android adaptive
		     padding renders the mark about two thirds size. See appicon_ios.svg for the whole
		     argument and the 1.6x number. NO Color: that file carries its own ground.
		     ⚠ MacCatalyst deliberately stays on the line above — it has never run (RocksDB
		     slice), so moving it would be an unverifiable change. -->
		<MauiIcon Condition="$(TargetFramework.Contains('-ios'))" Include="Resources\AppIcon\appicon_ios.svg" />
		<!-- ⚠⚠ NO Color ON THE WINDOWS LINE, AND THIS IS NOT AN OVERSIGHT. Damir on the first
		     build: "the logo is bigger, but the rectangle is sharp". MEASURED at the artifact
		     rather than guessed from the taskbar — every corner pixel of the generated
		     appicon_windows.ico AND of appicon_windowsLogo.*.png came back (0,118,225,255):
		     fully OPAQUE #0076E1. That is not this file's ground showing through a failed clip
		     — the ground carries a radial, so a leaked corner would vary between top-right and
		     bottom-left, and all four corners were identical and flat. It is the Color
		     attribute, which the resizetizer paints as a BACKGROUND behind the rasterised SVG
		     and which therefore floods exactly the transparency the rounded corners are made of.
		     ★ Windows does not need the fallback: this file carries its own ground. Android and
		     iOS keep theirs on the line above, where #689's measured blue still matters.
		     ⚠ VERIFY AT THE ARTIFACT, NEVER AT THE TASKBAR — Windows caches icons hard enough
		     that a correct build can show a stale square for as long as you are willing to
		     stare at it. The corner pixel of the built .ico is the answer. -->
		<MauiIcon Condition="$(TargetFramework.Contains('-windows'))" Include="Resources\AppIcon\appicon_windows.svg" />
		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#175595" BaseSize="128,128" />
		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />
		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>
	<ItemGroup>
		<MauiAsset Remove="Platforms\Android\Resources\values\styles.xml" />
		<MauiAsset Remove="Resources\Splash\splash.svg" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
		<PackageReference Include="CommunityToolkit.Maui" Version="14.2.0" />
		<PackageReference Include="Concentus" Version="2.2.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.71" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.71" />
		<PackageReference Include="Mono.Nat" Version="3.0.4" />

		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="OneSignalSDK.DotNet" Version="6.1.9" />
		<PackageReference Include="Plugin.Fingerprint" Version="3.0.0-beta.1" />
		<!-- Android and IOS: exclude native assets, use custom built RocksDB-Sharp -->
		<PackageReference Include="RocksDB" Version="0.0.42" Condition="$(TargetFramework.Contains('-android')) or $(TargetFramework.Contains('-ios'))">
			<ExcludeAssets>native</ExcludeAssets>
		</PackageReference>
		<!-- Other platforms: normal.
		     #920 (Session AC, route B): NOT maccatalyst any more — that TFM compiles the VENDORED wrapper
		     source under Platforms/MacCatalyst/RocksDbSharp/ (upstream rocksdb-sharp at the commit the dev's
		     nuspec names, binding native 10.4.2 like this package, with the Catalyst patch), because the
		     package's own loader mis-detects Catalyst as Windows (docs/mac-bringup-log.md). Keeping the package here too would compile
		     every RocksDbSharp type twice. -->
		<PackageReference Include="RocksDB" Version="10.4.2.64152" Condition="!$(TargetFramework.Contains('-android')) and !$(TargetFramework.Contains('-ios')) and !$(TargetFramework.Contains('-maccatalyst'))" />
	</ItemGroup>
	<ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
		<PackageReference Include="NAudio" Version="2.3.0" />
	</ItemGroup>
