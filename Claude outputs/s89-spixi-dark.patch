   .stage[data-skin='spixi'] .callout::before { left: -26px; right: auto; width: 18px; }
   .stage[data-skin='spixi'] .callout::after { left: -30px; right: auto; }
 }
+
+/* ======================================================================
+   Spixi's dark "glow-up" (app decision #989, 27 Sep 2026), mirrored here.
+   The app moved its dark mode from blue-tinted to near-neutral: canvas
+   #090A0D, chrome #0F1113, received bubbles and cards #1A1C1F with a 7 %
+   white hairline and a 4 % top highlight, sent cards a quiet blue fill
+   (#19253B) with a tinted edge instead of the 2px blue stroke, medallions a
+   translucent action tint. The sent bubble is the app's #2160C2, bubbles
+   use its 18px radius with the 4px group corner. Values are the app's
+   tokens (Spixi src/styles/tokens.css), not approximations.
+   ====================================================================== */
+.stage[data-skin='spixi'] {
+  --sx-bg: #090a0d; /* --chat-canvas-base = ink-1000 */
+  --sx-chrome: #0f1113; /* --surface-screen / topbar = ink-900 */
+  --sx-surface: #1a1c1f; /* --surface-bubble-received = ink-800 */
+  --sx-raised: #232528; /* ink-700 */
+  --sx-line: rgba(255, 255, 255, 0.07); /* --outline-hairline */
+  --sx-hi: rgba(255, 255, 255, 0.04); /* --highlight-top */
+  --sx-lift: 0 1px 1px rgba(0, 0, 0, 0.45); /* --bubble-elevation, dark */
+  --sx-text: #e8ecee; /* neutral-100 */
+  --sx-muted: #bbbec4; /* neutral-400: text-02 and received meta */
+  --sx-blue: #2160c2; /* --surface-bubble-sent */
+  --sx-sent-meta: #e9ecf3; /* brand-50 */
+  --sx-read: #8ff5b4; /* --icon-bubble-read */
+  --sx-accent: #769dff; /* primary-400: links, action text */
+  --sx-action: #3050bd; /* --surface-action-default = primary-600, white text */
+  --sx-send: #3050bd;
+  --sx-card-sent: #19253b; /* --surface-card-sent */
+  --sx-card-sent-edge: rgba(118, 157, 255, 0.22); /* --outline-card-sent */
+  --sx-medallion: rgba(118, 157, 255, 0.14); /* --surface-medallion */
+  --sx-medallion-ink: #9db8ff; /* --icon-medallion */
+  --sx-pill-edge: #37393c; /* --outline-composer-pill = neutral-500 */
+}
+.stage[data-skin='spixi'] .phone { box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.09), 0 40px 90px rgba(0, 0, 0, 0.6); }
+/* chrome: the header and the composer strip sit on the screen colour, the thread on the deeper canvas */
+.stage[data-skin='spixi'] .head { background: var(--sx-chrome); border-radius: 18px 18px 0 0; }
+.stage[data-skin='spixi'] .avatar { box-shadow: 0 0 0 2px var(--sx-chrome), 0 0 0 3px rgba(118, 157, 255, 0.25); }
+.stage[data-skin='spixi'] .mode[data-on] { box-shadow: inset 0 0 0 1px rgba(118, 157, 255, 0.5); }
+.stage[data-skin='spixi'] .day { background: var(--sx-surface); color: var(--sx-muted); }
+/* bubbles: the app's 18px radius, 4px on the group corner */
+.stage[data-skin='spixi'] .bubble { border-radius: 18px; }
+.stage[data-skin='spixi'] .bubble.out { background: var(--sx-blue); color: #f9fafb; border-bottom-right-radius: 4px; box-shadow: var(--sx-lift); }
+.stage[data-skin='spixi'] .bubble.in {
+  background: var(--sx-surface);
+  color: var(--sx-text);
+  border-bottom-left-radius: 4px;
+  box-shadow: inset 0 0 0 1px var(--sx-line), inset 0 1px 0 var(--sx-hi), var(--sx-lift);
+}
+.stage[data-skin='spixi'] .meta { color: var(--sx-sent-meta); }
+.stage[data-skin='spixi'] .meta svg { color: var(--sx-read); }
+.stage[data-skin='spixi'] .bubble.in .meta { color: var(--sx-muted); }
+/* received cards: the bubble surface with the same edge */
+.stage[data-skin='spixi'] .card.in,
+.stage[data-skin='spixi'] .callCard.in,
+.stage[data-skin='spixi'] .fileCard,
+.stage[data-skin='spixi'] .app {
+  background: var(--sx-surface);
+  box-shadow: inset 0 0 0 1px var(--sx-line), inset 0 1px 0 var(--sx-hi), var(--sx-lift);
+}
+/* sent cards: a quiet blue fill and a tinted edge, no 2px stroke */
+.stage[data-skin='spixi'] .card.out,
+.stage[data-skin='spixi'] .callCard.out {
+  background: var(--sx-card-sent);
+  box-shadow: inset 0 0 0 1px var(--sx-card-sent-edge), inset 0 1px 0 var(--sx-hi), var(--sx-lift);
+}
+.stage[data-skin='spixi'] .cmd { background: var(--sx-blue); color: #f9fafb; border-radius: 18px; border-bottom-right-radius: 4px; box-shadow: var(--sx-lift); }
+.stage[data-skin='spixi'] .cmd small { color: var(--sx-sent-meta); }
+/* medallions: file, app, call and card icons */
+.stage[data-skin='spixi'] .cardIcon,
+.stage[data-skin='spixi'] .fileIcon,
+.stage[data-skin='spixi'] .callCard[data-kind='voice'] .callIcon { background: var(--sx-medallion); color: var(--sx-medallion-ink); }
+/* the action button: the app's action blue with white text */
+.stage[data-skin='spixi'] .approve { background: var(--sx-action); color: #f9fafb; }
+.stage[data-skin='spixi'] .approve[data-on] { background: var(--sx-medallion); color: var(--sx-medallion-ink); }
+.stage[data-skin='spixi'] .seg { background: rgba(255, 255, 255, 0.06); }
+.stage[data-skin='spixi'] .segBtn[data-on],
+.stage[data-skin='spixi'] .seg i[data-on] { background: var(--sx-action); color: #f9fafb; }
+.stage[data-skin='spixi'] .segBtn[data-wait]:hover { background: var(--sx-medallion); }
+/* the composer: the pill on the bubble ground with its neutral edge, the send disc in the action blue */
+.stage[data-skin='spixi'] .composer { background: var(--sx-chrome); margin: 0; padding: 8px 10px 18px; border-radius: 0 0 18px 18px; }
+.stage[data-skin='spixi'] .field { background: var(--sx-surface); box-shadow: inset 0 0 0 1px var(--sx-pill-edge); }
+.stage[data-skin='spixi'] .composer i { background: var(--sx-send); color: #f9fafb; }
+/* the Apps screen and its tab bar */
+.stage[data-skin='spixi'] .appsSearch { box-shadow: inset 0 0 0 1px var(--sx-pill-edge); }
+.stage[data-skin='spixi'] .appTile { box-shadow: inset 0 0 0 1px var(--sx-line), inset 0 1px 0 var(--sx-hi); }
+.stage[data-skin='spixi'] button.appTile:hover { background: var(--sx-raised); }
+.stage[data-skin='spixi'] .tabBar { background: var(--sx-chrome); }
+.stage[data-skin='spixi'] .tabBar span[data-on] { background: var(--sx-medallion); }
+.stage[data-skin='spixi'] .appsScreen { background: var(--sx-chrome); }
