<?xml version="1.0" encoding="utf-8" ?>
<d:SpixiContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="clr-namespace:SPIXI;assembly=SPIXI"
             x:Class="SPIXI.HomePage">
    <ContentPage.Content>

        <Grid x:Name="mainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0" />
                <!-- Unit 6 (#247): chat-info pane column — 0 until a ContactDetails
                     overlay is pinned here (expanded at present time, code-behind). -->
                <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <WebView x:Name="webView" Navigating="onNavigating" Navigated="onNavigated" VerticalOptions="Fill" HorizontalOptions="Fill"  Grid.Column="0"/>
            <ContentView x:Name="rightContent" Grid.Column="1"/>
            <!-- D1 (#240): native pane divider — a thin pan-grip on column 0's trailing
                 edge (the visible hairline is painted by the home shell, #237 ⑦; this
                 stays transparent). Gestures + visibility wired in code-behind; sits
                 BEFORE any overlay stage in z-order, so takeovers/locks cover it. -->
            <BoxView x:Name="paneDivider" Grid.Column="0" WidthRequest="10" HorizontalOptions="End" VerticalOptions="Fill" Color="Transparent" BackgroundColor="Transparent" IsVisible="False" />
        </Grid>
        
    </ContentPage.Content>
</d:SpixiContentPage>